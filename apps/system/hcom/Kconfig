config SYSTEM_HCOM
	bool "Hcom example"
	default n
	---help---
		Enable the hcom example

if SYSTEM_HCOM

config SYSTEM_HCOM_PROGNAME
	string "Program name"
	default "hcom"
	---help---
		This is the name of the program that will be use when the NSH ELF
		program is installed.

endif
