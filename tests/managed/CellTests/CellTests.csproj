<Project Sdk="Microsoft.NET.Sdk">
  <!--
      Cell (PPP) tests as a Meadow app: the managed cell API (GNSS and signal quality) over the
      pppd pause path.  Needs a BG95-M3 on mikroBUS 1 (COM1, enable pin A3); a SIM is not needed.

      Meadow.Core comes from the meadow-3.0 checkout: MEADOW_CORE_DIR, or ../../meadow-3.0/Meadow.Core.
      The runner (tools/testrunner) chooses the Mono options by setting MEADOW_TEST_CONFIG to a
      generated meadow.config.yaml; without it the app ships the meadow.config.yaml from this
      folder.  cell.config.yaml is always shipped, because a deploy deletes every file in /meadow0
      that is not in the publish output: the placeholder in this folder (no SIM), or the file named
      by MEADOW_CELL_CONFIG.  Setting MEADOW_CELL_CONFIG also defines CELL_SIM, which makes the
      data link cases (cell.connected, cell.http_get) required instead of skipped.
      cell.ee.config.yaml in this folder holds EE's public settings; for a SIM on a private APN,
      point MEADOW_CELL_CONFIG at a local file instead of adding its credentials here.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>App</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</RepositoryRoot>
    <MeadowCoreDir Condition="'$(MEADOW_CORE_DIR)' != ''">$(MEADOW_CORE_DIR)</MeadowCoreDir>
    <MeadowCoreDir Condition="'$(MeadowCoreDir)' == ''">$(RepositoryRoot)/../../meadow-3.0/Meadow.Core</MeadowCoreDir>
    <MeadowTestConfig Condition="'$(MEADOW_TEST_CONFIG)' != ''">$(MEADOW_TEST_CONFIG)</MeadowTestConfig>
    <MeadowTestConfig Condition="'$(MeadowTestConfig)' == ''">$(MSBuildThisFileDirectory)meadow.config.yaml</MeadowTestConfig>
    <!-- A relative MEADOW_CELL_CONFIG is taken from the repository root; Combine keeps an absolute one. -->
    <MeadowCellConfig Condition="'$(MEADOW_CELL_CONFIG)' != ''">$([System.IO.Path]::Combine('$(RepositoryRoot)', '$(MEADOW_CELL_CONFIG)'))</MeadowCellConfig>
    <MeadowCellConfig Condition="'$(MeadowCellConfig)' == ''">$(MSBuildThisFileDirectory)cell.config.yaml</MeadowCellConfig>
    <DefineConstants Condition="'$(MEADOW_CELL_CONFIG)' != ''">$(DefineConstants);CELL_SIM</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckMeadowCore" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MeadowCoreDir)/Source/implementations/f7/Meadow.F7/Meadow.F7.csproj')" Text="No Meadow.Core at $(MeadowCoreDir).  Set MEADOW_CORE_DIR to the meadow-3.0 Meadow.Core checkout." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MeadowCoreDir)/Source/implementations/f7/Meadow.F7/Meadow.F7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MeadowTestConfig)" Link="meadow.config.yaml" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <None Include="$(MeadowCellConfig)" Link="cell.config.yaml" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
