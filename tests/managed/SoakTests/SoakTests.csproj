<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>App</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</RepositoryRoot>
    <MeadowCoreDir Condition="'$(MEADOW_CORE_DIR)' != ''">$(MEADOW_CORE_DIR)</MeadowCoreDir>
    <MeadowCoreDir Condition="'$(MeadowCoreDir)' == ''">$(RepositoryRoot)/../../meadow-3.0/Meadow.Core</MeadowCoreDir>
    <MeadowTestConfig Condition="'$(MEADOW_TEST_CONFIG)' != ''">$(MEADOW_TEST_CONFIG)</MeadowTestConfig>
    <MeadowTestConfig Condition="'$(MeadowTestConfig)' == ''">$(MSBuildThisFileDirectory)meadow.config.yaml</MeadowTestConfig>
  </PropertyGroup>

  <Target Name="CheckMeadowCore" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MeadowCoreDir)/Source/implementations/f7/Meadow.F7/Meadow.F7.csproj')" Text="No Meadow.Core at $(MeadowCoreDir).  Set MEADOW_CORE_DIR to the meadow-3.0 Meadow.Core checkout." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(MeadowCoreDir)/Source/implementations/f7/Meadow.F7/Meadow.F7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MEADOW_SOAK_WINDOWS</_Parameter1><_Parameter2>$(MEADOW_SOAK_WINDOWS)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MEADOW_SOAK_WINDOW_S</_Parameter1><_Parameter2>$(MEADOW_SOAK_WINDOW_S)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MEADOW_SOAK_SCENARIOS</_Parameter1><_Parameter2>$(MEADOW_SOAK_SCENARIOS)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MEADOW_SOAK_SERVER</_Parameter1><_Parameter2>$(MEADOW_SOAK_SERVER)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MEADOW_SOAK_HTTPS_URL</_Parameter1><_Parameter2>$(MEADOW_SOAK_HTTPS_URL)</_Parameter2></AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MeadowTestConfig)" Link="meadow.config.yaml" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
