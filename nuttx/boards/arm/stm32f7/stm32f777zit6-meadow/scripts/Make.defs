include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/arch/arm/src/armv7-m/Toolchain.defs

ifeq ($(CONFIG_BUILD_PROTECTED),y)
  # Protected build: vectors in uflash (0x08040000), kernel text in kflash (0x08140000).
  # Using kernel-space.ld keeps kernel code out of the uflash region that is
  # overlaid by the user-space blob at 0x08040200, preventing __start and all
  # other kernel functions from being silently overwritten at link time.
  ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)memory.ld
  ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)kernel-space.ld
else
  LDSCRIPT = flash.ld
  ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)
endif

# Force g_tcbinfo to be linked even when --gc-sections would otherwise discard
# it (nothing in the kernel binary references it directly, but OpenOCD's NuttX
# RTOS plugin requires the symbol to be present for task-aware debugging).
LDFLAGS += --undefined=g_tcbinfo

ARCHPICFLAGS = -fpic -msingle-pic-base -mpic-register=r10

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -I $(BOARD_DIR)$(DELIM)src -I $(BOARD_DIR)$(DELIM)src/meadow_os_link/include
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

EXEEXT = .elf

# The hcom app incorrectly uses EXEEXT in its PROGNAME, which breaks 
# Application.mk by creating an invalid C macro definition. 
# We force it to use a name without the extension here.
CONFIG_EXAMPLES_HCOM_PROGNAME = hcom
