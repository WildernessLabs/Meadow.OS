include $(TOPDIR)/Make.defs

CFLAGS += -I board/F7MeadowOSLink
CFLAGS += -Werror
$(shell [ -L F7MeadowOSLink ] || ln -sfn board/F7MeadowOSLink F7MeadowOSLink)

CSRCS = stm32_boot.c stm32_bringup.c stm32_spi.c

ifneq ($(CONFIG_ARCH_BOARD_COMMON),y)
CSRCS += stm32_reset.c
endif

ifeq ($(CONFIG_ARCH_LEDS),y)
CSRCS += stm32_autoleds.c
else
CSRCS += stm32_userleds.c
endif

ifeq ($(CONFIG_ARCH_BUTTONS),y)
CSRCS +=  stm32_buttons.c
endif

ifeq ($(CONFIG_BOARDCTL),y)
CSRCS += stm32_appinitialize.c
ifeq ($(CONFIG_BOARDCTL_IOCTL),y)
CSRCS += stm32_ioctl.c
endif
endif

ifeq ($(CONFIG_PWM),y)
CSRCS += stm32_pwm.c
endif

ifeq ($(CONFIG_SPORADIC_INSTRUMENTATION),y)
CSRCS += stm32_sporadic.c
endif

ifeq ($(CONFIG_STM32F7_FMC),y)
CSRCS += stm32_extmem.c
endif

ifeq ($(CONFIG_STM32F7_OTGFS),y)
CSRCS += stm32_usb.c
else ifeq ($(CONFIG_STM32F7_OTGFSHS),y)
CSRCS += stm32_usb.c
endif

ifeq ($(CONFIG_USBMSC),y)
CSRCS += stm32_usbmsc.c
endif

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CSRCS += stm32_idle.c
endif

ifeq ($(CONFIG_STM32F7_SDMMC2),y)
CSRCS += $(MEADOW_OS_DIR)/meadow_os/meadow_sdmmc.c
endif

ifdef MEADOW_OS

# Enable Meadow.OS build (WORK IN PROGRESS)
CSRCS += $(MEADOW_OS_DIR)/meadow_os/meadow-upd.c \
$(MEADOW_OS_DIR)/meadow_os/meadow-gpio.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_interrupt.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_hw_version.c \
$(MEADOW_OS_DIR)/ntpclient/meadow_ntpclient.c \
$(MEADOW_OS_DIR)/misc/meadow_cirbuf.c \
$(MEADOW_OS_DIR)/misc/parse_iso8601_time.c \
$(MEADOW_OS_DIR)/misc/meadow_client_cert.c \
$(MEADOW_OS_DIR)/misc/meadow_reinit_flash_size.c \
$(MEADOW_OS_DIR)/misc/meadow_stm32f7_clockenable.c \
$(MEADOW_OS_DIR)/misc/meadow_adc.c \
$(MEADOW_OS_DIR)/specialized/meadow_measure_freq.c \
$(MEADOW_OS_DIR)/specialized/meadow_rotary_encoder.c \
$(MEADOW_OS_DIR)/specialized/meadow_gpio_counter.c

MEADOW_OS_DIR=F7MeadowOSLink
CFLAGS += -DMEADOW_OS -I $(MEADOW_OS_DIR) -I $(TOPDIR) -I $(TOPDIR)/fs

ifeq ($(CONFIG_MEADOW_HCOM),y)
CSRCS += $(MEADOW_OS_DIR)/hcom_nx/hcom_nx_upd.c \
$(MEADOW_OS_DIR)/hcom_nx/hcom_nx_startup_mgr.c \
$(MEADOW_OS_DIR)/hcom_nx/hcom_nx_common_utils.c \
$(MEADOW_OS_DIR)/hcom_nx/hcom_nx_bbreg_access.c \
$(MEADOW_OS_DIR)/hcom_nx/hcom_nx_upd_route_cmd.c \
$(MEADOW_OS_DIR)/hcom_nx/hcom_nx_config_manager.c \
$(MEADOW_OS_DIR)/hcom_nx/create_fs/hcom_nx_fs_flash.c \
$(MEADOW_OS_DIR)/hcom_nx/create_fs/hcom_nx_fs_create.c \
$(MEADOW_OS_DIR)/hcom_nx/create_fs/hcom_nx_fs_littlefs.c \
$(MEADOW_OS_DIR)/hcom_nx/create_fs/hcom_nx_fs_part_utils.c \
$(MEADOW_OS_DIR)/hcom_nx/diag/hcom_traverse_ku_kernel.c \
$(MEADOW_OS_DIR)/hcom_nx/diag/hcom_nx_trace_msg_proc.c \
$(MEADOW_OS_DIR)/hcom_nx/tests/hcom_nx_qspi_flash_tests.c \
$(MEADOW_OS_DIR)/hcom_nx/create_fs/hcom_nx_fs_flash_tests.c

ifeq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CSRCS +=  $(MEADOW_OS_DIR)/specialized/meadow_idle_monitor.c
endif

ifeq ($(CONFIG_MEADOW_PWR_MGMT_SUPPORT),y)
CSRCS += $(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_calib_lsi_clock.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_config_wakeup_timer.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_config_wakeup_alarm.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_control.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_enter_stop_mode.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_misc.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_switch_rtc_clock.c \
$(MEADOW_OS_DIR)/pwrmgmt/pwrmgmt_time_support.c
endif

ifeq ($(CONFIG_MEADOW_TIMER_SUPPORT),y)
CSRCS += $(MEADOW_OS_DIR)/timers/timer_manager.c \
$(MEADOW_OS_DIR)/timers/cpu_measure.c \
$(MEADOW_OS_DIR)/timers/pulse_width.c \
$(MEADOW_OS_DIR)/timers/freq_duty.c \
$(MEADOW_OS_DIR)/timers/rc_servo_decode.c \
$(MEADOW_OS_DIR)/timers/lsi_clk_freq_measure.c
endif

CSRCS += $(MEADOW_OS_DIR)/ethernet/meadow_ethnet_start.c \
$(MEADOW_OS_DIR)/ethernet/meadow_ethnet_utils.c \
$(MEADOW_OS_DIR)/ethernet/meadow_ethnet_connect.c \
$(MEADOW_OS_DIR)/ethernet/meadow_ethnet_monitor.c \
$(MEADOW_OS_DIR)/ethernet/meadow_ethnet_dhcp.c

ifeq ($(CONFIG_MEADOW_ESPCP_MANAGER),y)
CSRCS += $(MEADOW_OS_DIR)/espcp/espcp_thread.c \
$(MEADOW_OS_DIR)/espcp/espcp_queue.c \
$(MEADOW_OS_DIR)/espcp/espcp_encoders.c \
$(MEADOW_OS_DIR)/espcp/espcp_message.c \
$(MEADOW_OS_DIR)/espcp/espcp_message_dispatcher.c \
$(MEADOW_OS_DIR)/espcp/generic_list.c \
$(MEADOW_OS_DIR)/espcp/espcp_coprocessor.c \
$(MEADOW_OS_DIR)/espcp/espcp_core_dump.c \
$(MEADOW_OS_DIR)/espcp/espcp_wifi.c \
$(MEADOW_OS_DIR)/espcp/espcp_system.c \
$(MEADOW_OS_DIR)/espcp/espcp_common.c \
$(MEADOW_OS_DIR)/espcp/espcp_usrsock_sockif.c \
$(MEADOW_OS_DIR)/espcp/espcp_uart_monitor.c \
$(MEADOW_OS_DIR)/espcp/espcp_event_handlers.c \
$(MEADOW_OS_DIR)/espcp/espcp_file_system.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os_espcp.c
endif

ifeq ($(CONFIG_MEADOW_WATCHDOGS),y)
CSRCS += $(MEADOW_OS_DIR)/misc/meadow_watchdog.c
endif

CSRCS += $(MEADOW_OS_DIR)/kerneltests/meadow_kt_dispatcher.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_kt_log.c \
$(MEADOW_OS_DIR)/kerneltests/espcp_tests.c \
$(MEADOW_OS_DIR)/kerneltests/ethernet_tests.c \
$(MEADOW_OS_DIR)/kerneltests/network_tests.c \
$(MEADOW_OS_DIR)/kerneltests/bg77_tests.c \
$(MEADOW_OS_DIR)/kerneltests/sdcard_tests.c \
$(MEADOW_OS_DIR)/kerneltests/power_management_tests.c \
$(MEADOW_OS_DIR)/kerneltests/iso8601_time_tests.c \
$(MEADOW_OS_DIR)/kerneltests/quick_misc_tests.c \
$(MEADOW_OS_DIR)/kerneltests/ana_to_dig_conv_tests.c \
$(MEADOW_OS_DIR)/kerneltests/dig_to_ana_conv_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_interrupt_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_spi_dma_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_rotary_encoder_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_os_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_measure_freq_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_kt_bluetooth_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_kt_traverse_ku_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_gpio_counter_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_i2c_tests.c \
$(MEADOW_OS_DIR)/kerneltests/meadow_pwm_tests.c

#
#	Add the Meadow logging system.
#
CSRCS += $(MEADOW_OS_DIR)/misc/meadow_logging.c

#
#	The libyaml library is required by cyaml.
#
CSRCS += $(MEADOW_OS_DIR)/libyaml/api.c $(MEADOW_OS_DIR)/libyaml/dumper.c $(MEADOW_OS_DIR)/libyaml/emitter.c $(MEADOW_OS_DIR)/libyaml/loader.c \
		 $(MEADOW_OS_DIR)/libyaml/parser.c $(MEADOW_OS_DIR)/libyaml/reader.c $(MEADOW_OS_DIR)/libyaml/scanner.c $(MEADOW_OS_DIR)/libyaml/writer.c
#
#	The cyaml library maps the items from the libyaml output to the structures used by the application.
#
CSRCS += $(MEADOW_OS_DIR)/libcyaml/mem.c $(MEADOW_OS_DIR)/libcyaml/free.c $(MEADOW_OS_DIR)/libcyaml/load.c $(MEADOW_OS_DIR)/libcyaml/save.c $(MEADOW_OS_DIR)/libcyaml/util.c $(MEADOW_OS_DIR)/libcyaml/utf8.c

#
#	Add Meadow Cloud support
#
ifeq ($(CONFIG_MEADOW_CLOUD),y)
CSRCS += $(MEADOW_OS_DIR)/meadow_cloud/meadow_cloud.c
endif

#
#	Add Meadow OS methods.
#
CSRCS += $(MEADOW_OS_DIR)/meadow_os/meadow_os_config.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os_info.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os_exceptions.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os_fault_handling.c \
$(MEADOW_OS_DIR)/meadow_os/meadow_os_battery_backed_domain.c

endif
endif # MEADOW_OS

ifeq ($(CONFIG_BOARD_MEADOW_F7_CORE_COMPUTE),y)
CSRCS += board_corecomp.c
endif

ifeq ($(CONFIG_BOARD_MEADOW_PROJECTLAB),y)
CSRCS += board_projlab.c
endif

ifeq ($(CONFIG_USBDEV_COMPOSITE),y)
CSRCS += stm32_composite.c
endif

DEPPATH += --dep-path board
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board
