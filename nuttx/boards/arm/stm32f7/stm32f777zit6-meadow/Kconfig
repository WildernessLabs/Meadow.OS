#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_MEADOW_F7MICRO

config HCOM_FILESYSTEM_INIT
    bool "Enables HCOM FS initialization support"
    default y

config HCOM_MTD_STRESS_TEST
    bool "Enables HCOM MTD stress testing support"
    default n

config HCOM_MONO_STDERR_STDOUT
    bool "Enables HCOM routing of Mono stdout and stderr to PC/Mac"
    default y

config HCOM_MONO_REMOTE_DEBUGGING
    bool "Enables HCOM Mono remote debugging support"
    default y

config HCOM_COMMS_DEVICE_NAME
    string "Specifies the device name for HCOM communications"
    default "/dev/ttyACM0"

config MEADOW_CLOUD
    bool "Enables Meadow Cloud support"
    default n
    select CRYPTO_MBEDTLS

config MEADOW_ETHNET_INCLUDE_IN_BUILD
    bool "Build Meadow and include Ethernet for compute module"
    default n
    ---help---
    This must be used with a 'defconfig' file that includes the correct Ethernet configuration.

config HCOM_ESP32_COMMS
    bool "Enables HCOM file download to the ESP32"
    default y

config MEADOW_WATCHDOGS
    bool "Enables the Meadow network deadlock watchdogs"
    default y
    depends on SCHED_LPWORK
    ---help---
    Arms a software watchdog around the usrsock socket, close and poll
    operations, all of which can block indefinitely if the ESP32
    coprocessor stops responding.  On expiry an exception is raised into
    the managed environment.  The expiry callback runs in interrupt
    context and defers its work to the low priority work queue, hence the
    dependency on SCHED_LPWORK.

config MEADOW_WATCHDOG_SLOTS
    int "Number of concurrently armed Meadow watchdogs"
    default 8
    depends on MEADOW_WATCHDOGS
    ---help---
    One watchdog timer is allocated from this pool for each guarded
    operation that is in flight.  When the pool is exhausted the operation
    runs unguarded, so this needs to cover the number of threads that can
    be inside those operations at the same time.

menu "ESP32 Coprocessor Configuration"
source "boards/arm/stm32f7/stm32f777zit6-meadow/Kconfig-ESP32"
endmenu

config ARCH_BOARD_MEADOW
    bool "Enables Meadow board features"
    default y

# See meadow-adc.c file, currently unused.
config MEADOW_ADC
    bool "Enables Meadow ADC support"

config MEADOW_HCOM
    bool "Enables Meadow HCOM support"
    default n

config MEADOW_TIMER_SUPPORT
    bool "Enables Meadow timer support"
    default n

config MEADOW_PWR_MGMT_SUPPORT
    bool "Enables Meadow power management support"
    default n

config BOARD_DUAL_CDCACM
	bool "Enable ttyACM0 and ttyACM1"
	select ARCH_BOARD_COMMON
	---help---
		When this option is enabled the board will register two
		USB CDC/ACM interfaces.

choice
	prompt "USB mass storage LUN backing"
	default MEADOW_USBMSC_SDCARD
	depends on USBMSC
	---help---
		What the USB mass storage LUN presents to a host computer.

config MEADOW_USBMSC_SDCARD
	bool "SD card"
	---help---
		Bind the LUN to /dev/mmcsd0. The card is already vfat formatted, so
		a host can read it without any translation. Nothing is exposed if no
		card is present.

config MEADOW_USBMSC_RAMDISK
	bool "FAT12 RAM disk (bring-up only)"
	---help---
		A small FAT12 formatted RAM disk, used to bring up and test the USB
		composite device in isolation from any file system work. Contents are
		recreated on every boot and lost at reset.

		The backing buffer is statically allocated and placed in DTCM. It has
		to be: in this PROTECTED build the additional heap regions, the
		external SDRAM at CONFIG_HEAP2_BASE included, are given to the user
		heap by kumm_addregion(), so kernel allocations can only draw on the
		much smaller CONFIG_MM_KERNEL_HEAPSIZE. ksram has only about 50 KB
		spare, whereas DTCM is 128 KB that nothing else claims because
		CONFIG_STM32F7_DTCMEXCLUDE keeps it out of every heap.

		Keep this available for bisecting USB problems, but it is not what
		ships.

config MEADOW_USBMSC_FATSHIM
	bool "Read-only FAT16 view of /meadow0"
	---help---
		Present the Meadow file system to a host computer as a FAT16 volume.

		No host operating system can read LittleFS, and USB mass storage is a
		block protocol in which the host runs the file system driver, so the
		only way a host can browse /meadow0 is for the board to fabricate a
		file system the host already understands. Nothing is stored: each
		sector read is answered by computing what a FAT16 volume holding those
		files would have contained at that offset.

		Read-only. The block driver has no write method, which is how NuttX
		is told to advertise the medium as write protected.

endchoice

config MEADOW_USBMSC_RAMDISK_SECTORS
	int "Bring-up RAM disk size in 512 byte sectors"
	default 128
	depends on MEADOW_USBMSC_RAMDISK
	---help---
		Number of 512 byte sectors in the bring-up RAM disk. The default of
		128 gives a 64 KB FAT12 volume, which keeps the static buffer small.
		Raise this if a host refuses to mount a volume that small.

choice
	prompt "Select Main Board Model"
	default BOARD_MEADOW_F7MICRO_DEFAULT
	---help---
		Select the mainboard model

config BOARD_MEADOW_F7MICRO_DEFAULT
	bool "Meadow F7 Micro Default"
	select ARCH_BOARD_COMMON
	---help---
		The default Meadow F7 Micro board with STM32F777,
		ESP32 for WiFi/Bluetooth, External Flash and RAM.

config BOARD_MEADOW_PROJECTLAB
	bool "ProjectLab Mainboard"
	select ARCH_BOARD_COMMON
	---help---
		ProjectLab is a main board with a Meadow F7Micro
		module soldered on it. The projectLab has a lot of
		sensors, RS485, a 3.2" TFT Display, and Grove, Qwiic
		and mikroBUS connectors for expansion.

config BOARD_MEADOW_F7_CORE_COMPUTE
	bool "F7 Core Compute Mainboard"
	select ARCH_BOARD_COMMON
	---help---
		The F7 Core Compute is a modular mainboard with basic
		features of F7-Micro, but with SDCard and Dual Ethernet.

endchoice # Select Main Board Model

endif # ARCH_BOARD_MEADOW_F7MICRO
