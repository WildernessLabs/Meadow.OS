      "loadFiles": [
        "${workspaceFolder}/nuttx/nuttx.elf",
        "${workspaceFolder}/nuttx/nuttx_user.elf",
      ],
      "symbolFiles": [
        "${workspaceFolder}/nuttx/nuttx.elf",
        "${workspaceFolder}/nuttx/nuttx_user.elf",
      ],
    }
  ]
