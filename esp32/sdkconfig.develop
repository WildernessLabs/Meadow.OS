#
#   Development configuration.
#

#
#   Override the partition table configuration.
#
#   The development partition table increases the size of the core dump partition.
#   This increased size allows for all of the RAM to be placed in the core dump for
#   improved analysis.
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-develop.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-develop.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y

#
#   Should we enable the diagnostic thread ?
#
CONFIG_ENABLE_DIAGNOSTIC_THREAD is not set
# CONFIG_ENABLE_DIAGNOSTIC_THREAD=y

#
#   Enable various assertions to be turned on.
#
# CONFIG_LWIP_ESP_LWIP_ASSERT=y
# CONFIG_HAL_ASSERTION_SILENT is not set
# CONFIG_HAL_ASSERTION_ENABLE is not set
# CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=2

#
#   Enable stack smashing and add a debug watchpoint at the end of the stack.
#
# CONFIG_COMPILER_STACK_CHECK_MODE_NONE is not set
# CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y
# CONFIG_COMPILER_STACK_CHECK=y
# CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

#
#   Compiler optimisation level to enable assertions.
#
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE is not set
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=2

#
#   Heap configuration.
#
# CONFIG_HEAP_TRACING_STANDALONE is not set
CONFIG_HEAP_TRACING_STANDALONE=y
CONFIG_TRACE_RECORD_NUM=100
CONFIG_HEAP_TRACING_TOHOST is not set
# CONFIG_HEAP_TRACING_TOHOST=y
# CONFIG_HEAP_TRACING_STACK_DEPTH=5
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# CONFIG_HEAP_TASK_TRACKING=y
CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS=y
# CONFIG_HEAP_POISONING_DISABLED is not set
# CONFIG_HEAP_POISONING_LIGHT is not set
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_ENABLE_HEAP_INTEGRITY_CHECKS=y
# CONFIG_ENABLE_HEAP_INTEGRITY_CHECKS is not set

#
#   The following configuration items should be enabled when
#   tracing to host is required.
#
# CONFIG_APPTRACE_DEST_JTAG=y
# CONFIG_APPTRACE_DEST_UART_NONE=y
# CONFIG_APPTRACE_UART_TASK_PRIO=1
# CONFIG_APPTRACE_DEST_TRAX=y
# CONFIG_APPTRACE_MEMBUFS_APPTRACE_PROTO_ENABLE=y
# CONFIG_APPTRACE_ENABLE=y
# CONFIG_APPTRACE_ONPANIC_HOST_FLUSH_TMO=-1
# CONFIG_APPTRACE_POSTMORTEM_FLUSH_THRESH=0
# CONFIG_APPTRACE_PENDING_DATA_SIZE_MAX=0
# CONFIG_APPTRACE_SV_ENABLE=y
# CONFIG_APPTRACE_SV_DEST_JTAG=y
# CONFIG_APPTRACE_SV_TS_SOURCE_GPTIMER=y
# CONFIG_APPTRACE_SV_MAX_TASKS=16
# CONFIG_APPTRACE_SV_BUF_WAIT_TMO=500
# CONFIG_APPTRACE_SV_EVT_OVERFLOW_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_ISR_ENTER_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_ISR_EXIT_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_ISR_TO_SCHED_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_START_EXEC_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_STOP_EXEC_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_START_READY_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_STOP_READY_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_CREATE_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TASK_TERMINATE_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_IDLE_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TIMER_ENTER_ENABLE=y
# CONFIG_APPTRACE_SV_EVT_TIMER_EXIT_ENABLE=y
# CONFIG_ESP32_MEMMAP_TRACEMEM=y
# CONFIG_ESP32_MEMMAP_TRACEMEM_TWOBANKS=y
# CONFIG_ESP32_TRACEMEM_RESERVE_DRAM=0x8000

# end of heap tracing to host.